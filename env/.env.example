# ==============================================================================
# DELSU ABRAKA BLOG (DELSU ABRAKA UPDATE BLOG TV)
# Master Environment Variables Template (.env.example)
# Stack: Next.js 14 (App Router) + Clerk + Supabase + Resend
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="DELSU Abraka Update Blog TV"
ADMIN_PASSWORD=delsu2026

# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION & USER MANAGEMENT
# Get these from: https://dashboard.clerk.com -> [Your App] -> API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Clerk Routing URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin

# Clerk Webhook Secret (from Clerk Dashboard -> Webhooks -> Add Endpoint -> Signing Secret)
# Webhook Endpoint: https://yourdomain.com/api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_clerk_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & STORAGE
# Get these from: https://supabase.com/dashboard/project/[project-ref]/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Service Role Key (Keep private! Used for server-side admin operations and webhooks)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET_COVERS=post-covers
SUPABASE_STORAGE_BUCKET_AVATARS=staff-avatars
SUPABASE_STORAGE_BUCKET_MEDIA=media-uploads

# ------------------------------------------------------------------------------
# 4. RESEND EMAIL MANAGEMENT
# Get these from: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here

# Resend Sender & Editorial Notification Inbox
# While testing, use: "DELSU Abraka Blog <onboarding@resend.dev>"
# In production, use your verified domain: "DELSU Abraka Blog <updates@delsublog.ng>"
RESEND_FROM_EMAIL="DELSU Abraka Blog <onboarding@resend.dev>"
EDITORIAL_NOTIFICATION_EMAIL=editor@delsublog.ng

# Optional: Resend Audience / Segment ID (from Resend -> Audiences)
RESEND_AUDIENCE_ID=
